@inherits LayoutComponentBase
@inject IOptions<SeasonOptions> Season

<a class="visually-hidden-focusable skip-link" href="#main">Skip to content</a>

<header class="site-header">
    <div class="container-narrow header-row">
        <a class="logo-tile logo-sm" href="https://tomorrow.org" target="_blank" rel="noopener">
            <img src="img/project-tomorrow-logo.jpg" alt="Project Tomorrow" width="120" height="70" />
        </a>
        <span class="brand-title">@Season.Value.SurveyTitle</span>
        <nav class="theme-switch" aria-label="Color theme">
            @foreach (var (mode, label) in Modes)
            {
                <a href="@($"theme?mode={mode}&return={Uri.EscapeDataString(ReturnPath)}")"
                   aria-current="@(mode == _current ? "true" : null)">@label</a>
            }
        </nav>
    </div>
    <div class="color-band" aria-hidden="true">
        <span style="background:#9CB43C"></span><span style="background:#6CA8CC"></span><span style="background:#D8846C"></span>
        <span style="background:#CC3024"></span><span style="background:#F0B420"></span><span style="background:#005090"></span>
    </div>
</header>

<main id="main" class="container-narrow py-4">
    @Body
</main>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private static readonly (string Mode, string Label)[] Modes = [("light", "Light"), ("dark", "Dark"), ("auto", "Auto")];
    private string _current = "auto";

    // After switching, come back to the same page. A form POST result can't be re-shown, so fall back to its URL (GET).
    private string ReturnPath => HttpContext is null ? "/" : HttpContext.Request.Path + HttpContext.Request.QueryString;

    protected override void OnInitialized() => _current = Theme.Current(HttpContext);
}
