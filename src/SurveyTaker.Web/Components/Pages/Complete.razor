@page "/complete"
@inherits SurveyPageBase
@inject IOptions<SeasonOptions> Season

@* Matches the Speak Up team's mockup (2026-10-09): logo tile, "Thank you!", one line with an inline tomorrow.org
   link (new tab), gold top edge. *@

<PageTitle>@T("ThankYou")</PageTitle>
<div class="thanks-card" lang="@(Es ? "es" : "en")">
    <div class="logo-tile logo-lg">
        <img src="img/project-tomorrow-logo.jpg" alt="Project Tomorrow" width="240" height="140" />
    </div>
    <h1>@T("ThankYou")</h1>
    <p>@string.Format(T("ThankYouBody"), Season.Value.ShortYear)<a href="https://tomorrow.org" target="_blank" rel="noopener">tomorrow.org</a>.</p>
</div>
<SiteFooter Full="true" />

@code {
    protected override string LogPage => "Complete";

    protected override async Task OnInitializedAsync()
    {
        // Load only for language; a bad or missing link still gets the thank-you page.
        if (await LoadSurveyAsync(allowCompleted: true))
            await Log.Info(LogPage, "Show", "TSI", Ctx!.TakenSurveyId.ToString());
        HttpContext.Response.Cookies.Delete("ProjectTomorrowSurvey");
    }
}
